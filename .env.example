# ---------- RealityCheck AI — environment example ----------
# Copy to .env and fill in real values. Never commit your real .env.

# PostgreSQL connection used by Drizzle ORM
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret for signing JWT session cookies (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Google AI Studio key for the Gemini API — server-side only, never exposed to the client.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Gemma 4 model identifier served through the Gemini API.
# Verified options: gemma-4-31b-it, gemma-4-26b-a4b-it, gemini-2.5-flash
GEMMA_MODEL=gemini-2.5-flash
